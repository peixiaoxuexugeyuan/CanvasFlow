{
  "templateUuid": "309dca81046a4188bb7857eff588e6bc",
  "name": "商业TVC后期包装参考生成器",
  "version": "1.0.0",
  "description": "根据实拍画面和文字需求，输出3套差异化标题包装方案，选定后输",
  "useScenario": "品牌TVC、短视频广告、剧情向商业短片、企业宣传片的标题包装创意设计，后期剪辑/包装师快速出文字排版和动画方案，对齐新片场商业广告大字包装风格。",
  "inputType": "上传实拍画面，同时输入文字需求：画面调性、需要包装的文字内容、画幅；可选补充品牌色、想要的字体风格、参考样图。技能会返回3套包装方案，你选择方案或者提出修改，即可拿到标准化动画参数。",
  "outputContent": "3套差异化标题包装创意方案；用户选定方案后，输出结构化后期包装参数，包含文字排版位置、字体方向、颜色、描边、入场/停留/出场动画、落地备注，可直接给到AE包装制作。",
  "ownerName": "微信用户3135ea",
  "ownerAvatar": "https://liblibai-online.liblib.cloud/web/avatar/avatar1.png",
  "primarySkillFilePath": "SKILL.md",
  "files": [
    {
      "path": "SKILL.md",
      "content": "{\n    \"skill_name\": \"商业写实TVC后期包装参考生成器 V2\",\n    \"skill_type\": \"后期包装创意参考工作流\",\n    \"description\": \"接收实拍参考图+文字方案，输出3套差异化包装方案，选定方案后输出AE/PR可用的结构化动画参数文本，适配品牌TVC、剧情短视频、生活向广告，字体开放不锁死，对齐该导演新片场作品包装风格\",\n    \"scenes\": [\"品牌TVC\", \"企业宣传片\", \"人文纪实短片\", \"产品广告\", \"轻剧情商业短片\"],\n    \"input_requirement\": {\n        \"must_input\": [\n            \"实拍参考画面（图片）\",\n            \"文字方案：片子主题、调性、待包装文字列表、画幅比例\"\n        ],\n        \"optional_input\": [\n            \"客户品牌色\",\n            \"是否增加图形装饰\",\n            \"片种说明\",\n            \"指定字体/字体风格方向\",\n            \"风格参考截图、过往包装偏好\"\n        ]\n    },\n    \"style_base\": {\n        \"font_rule\": \"字体不固定，根据画面调性自动匹配，支持用户强制指定字体；字体方向分类：现代商业粗无衬线、人文温润宋体/细黑体、青春圆润无衬线/轻手写体、科技窄体字、电影感复古宋体；有客户指定字体时优先使用指定字体，统一字重、字距规范\",\n        \"color_rule\": \"文字色可以取自画面提取色、品牌色、对比强调色；优先保证可读性；文字不能和人脸、核心产品主体冲突\",\n        \"layout_rule\": \"标题可放在底部三分之一、画面左右留白、人物肩部周边、画面中心；层级严格：主标题最大，副标题、注释文字依次缩小；支持错位排版、分行组合、局部关键词放大；可用装饰元素：细线框、箭头、标签胶囊、手绘圈注、低透明度色块\",\n        \"motion_rule\": {\n            \"entry\": \"淡入、平滑滑入、轻微推近\",\n            \"emphasis\": \"关键词缩放、描边擦入、色块跟随出现\",\n            \"stay\": \"稳定静止，无多余循环抖动\",\n            \"exit\": \"平滑淡出、位移离场、画面主体遮挡带出\"\n        }\n    },\n    \"execution_flow\": [\n        {\n            \"step_id\": 1,\n            \"step_name\": \"素材解析\",\n            \"action\": \"识别画面类型、主体位置、人脸/产品区域、明暗光影、留白；拆分文字层级（主标题、副标题、Slogan、强调词）；读取字体指定需求\"\n        },\n        {\n            \"step_id\": 2,\n            \"step_name\": \"输出3套包装方案\",\n            \"plan_list\": [\n                {\n                    \"plan_id\": \"A\",\n                    \"plan_name\": \"商业强标题版\",\n                    \"fit_scene\": \"品牌TVC、汽车、科技、产品发布、强观点广告\",\n                    \"layout\": \"大标题放置画面一侧/底部，和人物形成前后层级\",\n                    \"font_suggest\": \"粗无衬线、几何黑体、窄体标题字\",\n                    \"graphic\": \"细线、纯色块、局部描边\",\n                    \"motion_feeling\": \"干净、冲击力强、节奏利落\"\n                },\n                {\n                    \"plan_id\": \"B\",\n                    \"plan_name\": \"人文轻包装版\",\n                    \"fit_scene\": \"人文纪实、温情短片、企业宣传片、情绪向画面\",\n                    \"layout\": \"文字小面积悬浮，左/右对齐，保留画面呼吸感\",\n                    \"font_suggest\": \"细黑体、轻宋体、温润无衬线\",\n                    \"graphic\": \"细分割线、低透明底条、弱渐变\",\n                    \"motion_feeling\": \"安静克制、自然柔和\"\n                },\n                {\n                    \"plan_id\": \"C\",\n                    \"plan_name\": \"轻剧情活泼版\",\n                    \"fit_scene\": \"生活方式、种草短片、喜剧向商业广告\",\n                    \"layout\": \"文字和人物互动，关键词错位放大，局部重点词突出\",\n                    \"font_suggest\": \"圆润无衬线、手写感字体、轻综艺标题字\",\n                    \"graphic\": \"标签、箭头、圈注、轻贴纸图形\",\n                    \"motion_feeling\": \"活泼亲近、记忆点强\"\n                }\n            ]\n        },\n        {\n            \"step_id\": 3,\n            \"step_name\": \"交互确认\",\n            \"prompt\": \"请选择方案A/B/C；也可以提出修改需求：更换字体方向、调整位置、增减装饰元素、锁定某一张参考图风格\"\n        },\n        {\n            \"step_id\": 4,\n            \"step_name\": \"输出结构化后期动画参数\",\n            \"output_format\": {\n                \"画幅\": \"\",\n                \"安全边距\": \"\",\n                \"主标题\": {\n                    \"字体方向\": \"\",\n                    \"参考字体\": \"\",\n                    \"字重\": \"\",\n                    \"相对字号\": \"\",\n                    \"RGBA色值\": \"\",\n                    \"描边参数\": \"\",\n                    \"对齐方式\": \"\",\n                    \"位置区域\": \"\",\n                    \"图形元素\": \"\",\n                    \"入场动画\": \"\",\n                    \"停留时长\": \"\",\n                    \"出场动画\": \"\"\n                },\n                \"副标题\": {},\n                \"强调词\": {}\n            }\n        },\n        {\n            \"step_id\": 5,\n            \"step_name\": \"后期备注提示\",\n            \"notes\": [\n                \"整套包装保持字重层级统一：标题重、副标题轻、注释最轻\",\n                \"文字必须避让人物面部、产品主体、强反光区域\",\n                \"亮背景可增加弱底衬/细描边保证可读，暗画面降低文字对比度\",\n                \"动画切点匹配BGM重拍或者画面动作\"\n            ]\n        }\n    ],\n    \"forbidden_rule\": [\n        \"禁止输出无法落地的纯概念特效\",\n        \"不主动使用厚描边、强发光、爆炸贴纸，除非用户明确指定风格需要\",\n        \"禁止遮挡人脸、核心产品主体\",\n        \"参数输出保持结构化干净文本，不堆砌冗余感性描述\"\n    ]\n}\n",
      "contentType": "text/markdown",
      "primary": true
    }
  ],
  "sourceUrl": "https://www.liblib.tv/skill",
  "capturedAt": "2026-11-14",
